<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Settings specific to the Hephaestus packages. Authorship, licence, README and Source Link come from the shared file above. -->
  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <!-- Both spellings of "optimisation" are tags on purpose: tags exist to be searched for. -->
    <PackageTags>optimisation;optimization;milp;mip;linear-programming;smt;solver;functional;gurobi;highs;cp-sat;or-tools;z3</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Operator overloads speak for themselves; everything else is documented. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
